@page "/Catalog/List"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Data
@using global::Microsoft.AspNetCore.Authorization
@inject CatalogData CatalogData

<PageTitle>Catalog</PageTitle>

<div class="card">
    <h2>Catalog</h2>
    <p class="note">A row is marked when on hand is at or under the reorder point. This list includes inactive products. The low-stock report does not.</p>
    <div class="row">
        <input type="text" @bind="searchTerm" />
        <label>
            <input type="checkbox" @bind="lowStockOnly" /> Low stock only
        </label>
        <button @onclick="Search">Search</button>
        <a href="Catalog/Edit">New product</a>
    </div>

    @if (pagedProducts.Count == 0)
    {
        <p>No products.</p>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>On hand</th>
                    <th>Reorder</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @{ int rowIndex = 0; }
                @foreach (var row in pagedProducts)
                {
                    int onHand = Convert.ToInt32(row["OnHand"]);
                    int reorder = Convert.ToInt32(row["ReorderPoint"]);
                    string rowCss = (onHand <= reorder) ? "low" : (rowIndex % 2 == 1 ? "alt" : "");
                    <tr class="@rowCss">
                        <td>@row["Sku"]</td>
                        <td>@row["ProductName"]</td>
                        <td>@(Convert.ToDecimal(row["UnitPrice"]).ToString("N2"))</td>
                        <td>@row["OnHand"]</td>
                        <td>@row["ReorderPoint"]</td>
                        <td>@row["ActiveText"]</td>
                        <td><a href="@($"Catalog/Edit?id={row["ProductId"]}")">Open</a></td>
                    </tr>
                    rowIndex++;
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <div class="pager">
                @for (int p = 0; p < totalPages; p++)
                {
                    int pageIndex = p;
                    if (pageIndex == currentPage)
                    {
                        <span>@(pageIndex + 1)</span>
                    }
                    else
                    {
                        <a href="#" @onclick="() => GoToPage(pageIndex)" @onclick:preventDefault>@(pageIndex + 1)</a>
                    }
                }
            </div>
        }
    }
</div>

@code {
    private string searchTerm = string.Empty;
    private bool lowStockOnly;
    private List<DataRow> allProducts = new();
    private List<DataRow> pagedProducts = new();
    private int currentPage;
    private int totalPages;
    private const int PageSize = 5;

    protected override void OnInitialized()
    {
        BindGrid();
    }

    private void Search()
    {
        currentPage = 0;
        BindGrid();
    }

    private void GoToPage(int pageIndex)
    {
        currentPage = pageIndex;
        ApplyPaging();
    }

    private void BindGrid()
    {
        DataTable table = CatalogData.List(searchTerm, lowStockOnly);
        allProducts = table.Rows.Cast<DataRow>().ToList();
        ApplyPaging();
    }

    private void ApplyPaging()
    {
        totalPages = (int)Math.Ceiling((double)allProducts.Count / PageSize);
        if (currentPage >= totalPages && totalPages > 0)
        {
            currentPage = totalPages - 1;
        }
        pagedProducts = allProducts
            .Skip(currentPage * PageSize)
            .Take(PageSize)
            .ToList();
    }
}
