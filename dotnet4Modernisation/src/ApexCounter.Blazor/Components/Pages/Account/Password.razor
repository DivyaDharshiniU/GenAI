@page "/Account/Password"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject AuthData AuthData

<PageTitle>Password</PageTitle>

<div class="card">
    <h2>Password</h2>
    <p class="note">The new password must be at least 6 characters. Changing clerk leaves supervisor on counter2011, and the other way around.</p>

    @if (!string.IsNullOrEmpty(lblMessage))
    {
        <span class="msg">@lblMessage</span>
    }

    <EditForm Model="model" FormName="changePassword" OnValidSubmit="BtnSaveClick">
        <DataAnnotationsValidator />

        <div class="row">
            <label>Current</label>
            <InputText id="txtCurrent" type="password" @bind-Value="model.CurrentPassword" />
            <ValidationMessage For="@(() => model.CurrentPassword)" />
        </div>
        <div class="row">
            <label>New</label>
            <InputText id="txtNew" type="password" @bind-Value="model.NewPassword" />
            <ValidationMessage For="@(() => model.NewPassword)" />
        </div>
        <div class="row">
            <label>Confirm</label>
            <InputText id="txtConfirm" type="password" @bind-Value="model.ConfirmPassword" />
            <ValidationMessage For="@(() => model.ConfirmPassword)" />
        </div>

        <button type="submit">Update password</button>
    </EditForm>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private PasswordModel model = new();
    private string lblMessage = string.Empty;

    private async Task BtnSaveClick()
    {
        if (model.NewPassword != model.ConfirmPassword)
        {
            lblMessage = Messages.PasswordMismatch;
            return;
        }

        var authState = await AuthState!;
        var userIdClaim = authState.User.FindFirst("UserId");
        int userId = userIdClaim != null ? Convert.ToInt32(userIdClaim.Value) : 0;

        ActionResult result = AuthData.ChangePassword(userId, model.CurrentPassword, model.NewPassword);
        lblMessage = result.Message;

        if (result.Ok)
        {
            model = new PasswordModel();
        }
    }

    private sealed class PasswordModel
    {
        [Required(ErrorMessage = "Enter the current password.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a new password.")]
        [MinLength(6, ErrorMessage = "The new password must be at least 6 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm the new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The new password and the confirmation do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
