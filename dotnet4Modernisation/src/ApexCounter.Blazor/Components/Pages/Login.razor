@page "/Login"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@layout EmptyLayout

@* Static SSR page. The form posts to the /auth/login endpoint (see Program.cs)
   on a real HTTP request, so HttpContext.SignInAsync can write the auth cookie.
   Sign-in must NOT run inside a Blazor render (interactive or static), where the
   Set-Cookie header is not reliably flushed — that made login silently fail. *@

<PageTitle>Sign in · Apex Counter</PageTitle>

<div class="login-body">
    <div class="login-card">
        <p class="stamp">Blazor · .NET 8</p>
        <h1>Apex Counter</h1>
        <p>Parts desk for Apex Industrial Supply. Stock changes only when an order is picked.</p>
        @* data-enhance="false": force a full browser POST, not Blazor enhanced
           navigation. Enhanced nav races with the auth redirect and can leave the
           browser on /Login intermittently. *@
        <form method="post" action="/auth/login" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div class="row">
                <label for="txtUser">Username</label>
                <input id="txtUser" name="userName" type="text" />
                @if (showUserRequired)
                {
                    <span class="err">Enter a username.</span>
                }
            </div>
            <div class="row">
                <label for="txtPassword">Password</label>
                <input id="txtPassword" name="password" type="password" />
                @if (showPasswordRequired)
                {
                    <span class="err">Enter a password.</span>
                }
            </div>
            <button type="submit">Sign in</button>
            <p class="err">@errorMessage</p>
            <p class="note">Classroom sign-in: clerk or supervisor. Password counter2011.</p>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "f")]
    private string? Field { get; set; }

    private string errorMessage = string.Empty;
    private bool showUserRequired;
    private bool showPasswordRequired;

    protected override void OnParametersSet()
    {
        errorMessage = Error switch
        {
            "bad" => Messages.LoginFailed,
            "db" => Messages.DbDown,
            _ => string.Empty
        };

        if (Error == "required")
        {
            showUserRequired = Field is "user" or "both";
            showPasswordRequired = Field is "pass" or "both";
        }
    }
}
