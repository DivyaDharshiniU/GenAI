@page "/Catalog/Edit"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Data
@using System.Globalization

@inject NavigationManager Navigation

<PageTitle>Product</PageTitle>

<div class="card">
    <h2>Product</h2>
    <p class="note">Saving the price does not change lines already on an order. On hand changes only through Adjust stock. A new product starts at 0.</p>
    @if (!string.IsNullOrEmpty(lblMessage))
    {
        <span class="msg">@lblMessage</span>
    }
    <EditForm Model="productModel" FormName="editProduct" OnValidSubmit="BtnSave_Click">
        <DataAnnotationsValidator />
        <div class="row">
            <label>SKU</label>
            <input id="txtSku" type="text" maxlength="20" @bind="productModel.Sku" />
            <ValidationMessage For="@(() => productModel.Sku)" />
        </div>
        <div class="row">
            <label>Name</label>
            <input id="txtName" type="text" maxlength="120" @bind="productModel.Name" />
            <ValidationMessage For="@(() => productModel.Name)" />
        </div>
        <div class="row">
            <label>Price</label>
            <input id="txtPrice" type="text" @bind="productModel.PriceText" />
            <ValidationMessage For="@(() => productModel.PriceText)" />
        </div>
        <div class="row">
            <label>Reorder point</label>
            <input id="txtReorder" type="text" @bind="productModel.ReorderText" />
            <ValidationMessage For="@(() => productModel.ReorderText)" />
        </div>
        <div class="row">
            <label>On hand</label>
            <span id="lblOnHand">@onHand</span>
        </div>
        <div class="row">
            <label>Active</label>
            <input id="chkActive" type="checkbox" @bind="productModel.IsActive" />
        </div>
        <button type="submit">Save</button>
        <button type="button" class="btn quiet" @onclick="BtnCancel_Click">Back</button>
    </EditForm>
</div>

@if (showAdjustPanel)
{
    <div class="card">
        <h2>Adjust stock</h2>
        <p class="note">Use a negative number to remove stock. Zero is refused. The reason is written on the ledger.</p>
        <div class="row">
            <label>Quantity change</label>
            <input id="txtAdjustQty" type="text" @bind="adjustQty" />
        </div>
        <div class="row">
            <label>Reason</label>
            <input id="txtAdjustNote" type="text" maxlength="200" @bind="adjustNote" />
        </div>
        <button type="button" @onclick="BtnAdjust_Click">Adjust</button>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    private int? Id { get; set; }

    [SupplyParameterFromQuery(Name = "saved")]
    private string? Saved { get; set; }

    private ProductEditModel productModel = new();
    private string lblMessage = string.Empty;
    private string onHand = "0";
    private bool showAdjustPanel;

    private string adjustQty = string.Empty;
    private string adjustNote = string.Empty;

    protected override void OnInitialized()
    {
        int id = GetId();
        showAdjustPanel = id > 0;
        if (id == 0) return;
        LoadProduct(id);
    }

    private int GetId()
    {
        if (Id.HasValue && Id.Value > 0) return Id.Value;
        return 0;
    }

    private void LoadProduct(int id)
    {
        DataRow? row = CatalogData.Find(id);
        if (row == null)
        {
            lblMessage = Messages.NotFound;
            showAdjustPanel = false;
            return;
        }
        productModel.Sku = Convert.ToString(row["Sku"]) ?? string.Empty;
        productModel.Name = Convert.ToString(row["ProductName"]) ?? string.Empty;
        productModel.PriceText = Convert.ToDecimal(row["UnitPrice"]).ToString("N2");
        productModel.ReorderText = Convert.ToString(row["ReorderPoint"]) ?? string.Empty;
        onHand = Convert.ToString(row["OnHand"]) ?? "0";
        productModel.IsActive = Convert.ToBoolean(row["IsActive"]);
        if (Saved == "1")
        {
            lblMessage = string.Format(Messages.ProductSaved, productModel.Sku);
        }
    }

    private void BtnSave_Click()
    {
        decimal price;
        int reorder;
        if (!decimal.TryParse(productModel.PriceText?.Trim(), NumberStyles.Number, CultureInfo.GetCultureInfo("en-US"), out price) || price < 0)
        {
            lblMessage = Messages.BadPrice;
            return;
        }
        if (!int.TryParse(productModel.ReorderText?.Trim(), out reorder) || reorder < 0)
        {
            lblMessage = Messages.BadReorder;
            return;
        }

        int id = GetId();
        ActionResult result = CatalogData.Save(id, productModel.Sku ?? string.Empty, productModel.Name ?? string.Empty, price, reorder, productModel.IsActive);
        if (!result.Ok || id > 0)
        {
            lblMessage = result.Message;
            return;
        }
        Navigation.NavigateTo($"/Catalog/Edit?id={result.Id}&saved=1");
    }

    private async Task BtnAdjust_Click()
    {
        int qty;
        if (!int.TryParse(adjustQty?.Trim(), out qty) || qty == 0)
        {
            lblMessage = Messages.BadAdjust;
            return;
        }
        int currentUserId = await GetCurrentUserIdAsync();
        ActionResult result = CatalogData.Adjust(GetId(), qty, adjustNote ?? string.Empty, currentUserId);
        lblMessage = result.Message;
        if (result.Ok)
        {
            onHand = result.Id.ToString();
            adjustQty = string.Empty;
            adjustNote = string.Empty;
        }
    }

    private async Task<int> GetCurrentUserIdAsync()
    {
        if (AuthState == null) return 0;
        var authState = await AuthState;
        var user = authState.User;
        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            return userId;
        }
        return 0;
    }

    private void BtnCancel_Click()
    {
        Navigation.NavigateTo("/Catalog/List");
    }

    private sealed class ProductEditModel
    {
        [Required(ErrorMessage = "Enter a SKU.")]
        [MaxLength(20)]
        public string? Sku { get; set; }

        [Required(ErrorMessage = "Enter a name.")]
        [MaxLength(120)]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Enter a price.")]
        public string? PriceText { get; set; }

        [Required(ErrorMessage = "Enter a reorder point.")]
        public string? ReorderText { get; set; }

        public bool IsActive { get; set; } = true;
    }
}
